{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"ignorePatterns": ["drune/engine.js"],
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"rules": {},
	"overrides": [
		{
			"files": ["src/**/*.js"],
			"env": { "browser": true },
			"rules": { "no-undef": "error" }
		}
	],
	"env": {
		"builtin": true
	}
}
