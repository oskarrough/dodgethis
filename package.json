{
	"name": "dodgethis",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "bun run check && vite build",
		"preview": "vite preview",
		"check": "oxlint --quiet && oxfmt --check && bun test --parallel --only-failures",
		"test": "bun test",
		"test:slow": "SLOW=1 bun test",
		"bench": "bun scripts/bench.js",
		"farm": "bun scripts/farm.js",
		"balance": "duckdb -no-init -bail -markdown -f scripts/balance.sql",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@dimforge/rapier3d": "0.21.0",
		"lil-gui": "^0.21.0",
		"three": "^0.186.1"
	},
	"devDependencies": {
		"@dimforge/rapier3d-compat": "^0.21.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"vite": "^8.3.2",
		"vite-plugin-wasm": "^3.6.0",
		"wrangler": "^4.147.0"
	}
}
