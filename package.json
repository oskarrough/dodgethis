{
	"name": "dodgethis",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "bun run collect-mods",
		"dev": "vite",
		"dev:agent": "sh scripts/dev-agent.sh",
		"build": "bun run check && vite build",
		"preview": "vite preview",
		"check": "bun run collect-mods && bun scripts/check-moba-units.js && bun scripts/check-moba-effects.js && oxlint --quiet && oxfmt --check && bun test --parallel --only-failures",
		"test": "bun test",
		"test:slow": "SLOW=1 bun test",
		"profile:dodgeball": "bun scripts/bench.js",
		"simulate": "bun scripts/farm.js",
		"kit": "bun run collect-mods && bun scripts/kit.js",
		"review": "bun scripts/review.js",
		"sound:check": "bun scripts/sound-check.js",
		"sound:sync": "bun scripts/sound-library.js",
		"where": "bun scripts/where.js",
		"collect-mods": "bun scripts/collect-mods.js",
		"play:headless": "bun scripts/play.js",
		"verify:browser": "node scripts/verify-moba-playability.mjs",
		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@dimforge/rapier3d": "0.21.0",
		"lil-gui": "^0.21.0",
		"three": "^0.186.1"
	},
	"devDependencies": {
		"@dimforge/rapier3d-compat": "^0.21.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"vite": "^8.3.5",
		"vite-plugin-wasm": "^3.6.0",
		"wrangler": "^4.151.3"
	}
}
